{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whiteboard",
  "version": "0.1.0",
  "identifier": "dev.whiteboard.app",
  "build": {
    "devUrl": "http://localhost:1520",
    "frontendDist": "../../dist",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../.." },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../.." }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Whiteboard",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 26 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: https: http:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
